# You.com APIs (get from https://api.you.com)
YDC_API_KEY=your_ydc_api_key_here

# Parasail (get from https://parasail.ai)
PARASAIL_API_KEY=your_parasail_api_key_here

# LLM Provider (at least one)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Alpaca Paper Trading (get from https://alpaca.markets)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# Opsera (get from https://opsera.io)
OPSERA_TOKEN=your_opsera_token_here
OPSERA_ORG=your_org_name

# Render (optional, for deployment)
RENDER_API_KEY=your_render_key_here